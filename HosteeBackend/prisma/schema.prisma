// Get a free hosted Postgres database: `npx create-db`

// 1. Data Source: Tells Prisma how to connect to your database
datasource db {
  provider = "postgresql" // Options: mysql, sqlite, sqlserver, mongodb, cockroachdb
}

// 2. Generator: Tells Prisma to generate the type-safe client for TypeScript
generator client {
  provider = "prisma-client-js"
}


// ---------------------------------
// Enums (Types)
// ---------------------------------

enum Role {
  ADMIN
  MANAGER
  RECEPTIONIST
  CLEANER
}


// ---------------------------------
// Models (Tables)
// ---------------------------------

model User {
  id String @id @default(uuid())
  email String @unique
  password String
  name String 
  role Role @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
