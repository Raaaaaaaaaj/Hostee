// Data Source: Connection to PostgreSQL database
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Generator: Generates Prisma Client for TypeScript
generator client {
  provider = "prisma-client-js"
}

// ---------------------------------
// Enums (Types)
// ---------------------------------

enum Role {
  SUPER_ADMIN
  HOTEL_ADMIN
  MANAGER
  RECEPTIONIST
  CLEANER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SubscriptionTier {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

// ---------------------------------
// Models (Tables)
// ---------------------------------

// Master Tenant Model (Represents a Hotel / Client Organization)
model Tenant {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique // e.g. "hotel1", "grand-view"
  customDomain     String?          @unique
  status           TenantStatus     @default(ACTIVE)
  subscriptionTier SubscriptionTier @default(FREE)
  users            User[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// User Model (Scoped to a Tenant or Platform Super Admin)
model User {
  id        String   @id @default(uuid())
  tenantId  String?  // Nullable for Super Admins
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String   @unique
  password  String
  name      String
  role      Role     @default(HOTEL_ADMIN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}
